{
  "name": "upwork-autobidder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute autobidder --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute autobidder --local --file=./schema.sql",
    "db:demo:local": "wrangler d1 execute autobidder --local --file=./seed-demo.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run typecheck && npm test && npm run check:bundle"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "esbuild": "0.28.2",
    "typescript": "5.6.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
